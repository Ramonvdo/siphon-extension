{
  "manifest_version": 3,
  "name": "Siphon Stream Finder",
  "version": "1.0.0",
  "description": "Find downloadable video/audio streams (.m3u8 / .mpd) on the current page and copy them into Siphon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "siphon-stream-finder@siphon.app",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["browser-polyfill.min.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Siphon Stream Finder",
    "default_icon": {
      "16": "icon-128.png",
      "48": "icon-128.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-128.png",
    "48": "icon-128.png",
    "128": "icon-128.png"
  }
}
