{
  "manifest_version": 3,
  "name": "Siphon Stream Finder",
  "version": "1.1.1",
  "description": "Lists the HLS and DASH manifest URLs a page requests, so you can inspect or copy them.",
  "browser_specific_settings": {
    "gecko": {
      "id": "siphon-stream-finder@siphon.app",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "browser-polyfill.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Siphon Stream Finder",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
